# Binance Testnet — generate at https://testnet.binance.vision/
BINANCE__API_KEY=your-binance-testnet-api-key
BINANCE__API_SECRET=your-binance-testnet-api-secret
BINANCE__TESTNET=true

# Capital.com demo account — optional. Leave unset to run with BTC/USDT
# only; NASDAQ/Gold report as unavailable instead of the app failing to boot.
# CAPITAL__API_KEY=your-capital-api-key
# CAPITAL__IDENTIFIER=your-capital-email
# CAPITAL__PASSWORD=your-capital-password
# CAPITAL__DEMO=true

# Origins allowed to call the API (comma-separated). Defaults to the local
# Next.js dev server.
# ALLOWED_ORIGINS=http://localhost:3000

# Optional shared secret required (X-API-Key header) on endpoints that
# place orders or start/stop bots. Leave unset for local dev.
# API_KEY=
